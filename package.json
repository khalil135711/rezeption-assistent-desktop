{
  "name": "rezeption-assistent",
  "version": "1.0.0",
  "description": "Rezeptions-Assistent für Reha-Einrichtungen: Termine, Kunden, Kasse, lokaler Assistent ohne API",
  "main": "main.js",
  "author": "khalil135711",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.rezeption.assistent",
    "productName": "Rezeption Assistent",
    "files": ["main.js", "src/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.business" },
    "linux": { "target": ["AppImage", "deb"], "category": "Office" }
  }
}
